{
    "$schema": "https://opencode.ai/config.json",
    "agent": {
        "novaspins-review-agent": {
            "description": "Executor determin\u00edstico de bug hunt NovaSpins. Sem subagents. Pipeline fixo: Bootstrap \u2192 Fase 1-4 \u2192 PARADA \u2192 Fase 5 (1 bug por vez) \u2192 Fase 6. Pre-commit Brief \u00e9 o gate de aprova\u00e7\u00e3o antes de cada commit.",
            "mode": "primary",
            "temperature": 0,
            "color": "#c0392b",
            "prompt": "{file:./.opencode/agents/novaspins-review-agent.md}",
            "permission": {
                "edit": "allow",
                "webfetch": "deny",
                "bash": {
                    "*": "allow",
                    "ls *": "allow",
                    "find *": "allow",
                    "cat *": "allow",
                    "sed -n *": "allow",
                    "echo *": "allow",
                    "printf *": "allow",
                    "grep *": "allow",
                    "grep -r *": "allow",
                    "grep -rn *": "allow",
                    "grep -rl *": "allow",
                    "grep -rni *": "allow",
                    "grep -E *": "allow",
                    "grep -i *": "allow",
                    "wc *": "allow",
                    "bc": "allow",
                    "bc *": "allow",
                    "date *": "allow",
                    "diff *": "allow",
                    "jq *": "allow",
                    "openssl dgst *": "allow",
                    "sleep *": "allow",
                    "tee /tmp/*": "allow",
                    "cat /tmp/*": "allow",
                    "mkdir -p .opencode*": "allow",
                    "touch .opencode*": "allow",
                    "git status": "allow",
                    "git status *": "allow",
                    "git diff": "allow",
                    "git diff *": "allow",
                    "git log *": "allow",
                    "git show *": "allow",
                    "git blame *": "allow",
                    "git rev-parse *": "allow",
                    "git add *": "allow",
                    "git commit *": "allow",
                    "git checkout -- *": "allow",
                    "git reset --soft *": "ask",
                    "git reset --hard *": "ask",
                    "git push *": "ask",
                    "curl -s http://localhost:8080/*": "allow",
                    "curl -i http://localhost:8080/*": "allow",
                    "curl -s http://127.0.0.1:8080/*": "allow",
                    "curl -s -o /tmp/* -w * http://localhost:8080/*": "allow",
                    "curl -i -s -X POST http://localhost:8080/api/providers/novaspins/callback *": "allow",
                    "curl -i -s -X POST http://localhost:8080/api/providers/novaspins/callback/replay *": "allow",
                    "curl -s http://localhost:8080/api/players/*": "allow",
                    "curl -i http://localhost:8080/api/players/*": "allow",
                    "docker compose ps": "allow",
                    "docker compose ps *": "allow",
                    "docker compose ls": "allow",
                    "docker compose top": "allow",
                    "docker compose logs *": "allow",
                    "docker compose up -d": "allow",
                    "docker compose up -d *": "allow",
                    "docker compose exec app cat *": "allow",
                    "docker compose exec app grep *": "allow",
                    "docker compose exec app find *": "allow",
                    "docker compose exec app tail -f *": "allow",
                    "docker compose exec app php -v": "allow",
                    "docker compose exec app php -i": "allow",
                    "docker compose exec app php artisan route:list *": "allow",
                    "docker compose exec app php artisan config:show *": "allow",
                    "docker compose exec app php artisan tinker --execute *": "allow",
                    "docker compose exec app php artisan make:test *": "allow",
                    "docker compose exec app php artisan test": "allow",
                    "docker compose exec app php artisan test *": "allow",
                    "docker compose exec app php artisan migrate:fresh --seed": "ask",
                    "docker compose exec app php artisan migrate *": "ask",
                    "docker compose exec app vendor/bin/phpunit": "allow",
                    "docker compose exec app vendor/bin/phpunit *": "allow",
                    "docker compose exec app vendor/bin/pint --dirty": "allow",
                    "docker compose exec app vendor/bin/pint --dirty *": "allow",
                    "docker compose exec app vendor/bin/php-cs-fixer fix --dry-run --diff": "allow",
                    "docker compose exec app vendor/bin/php-cs-fixer fix --dry-run *": "allow",
                    "docker compose exec app vendor/bin/php-cs-fixer fix *": "ask",
                    "docker compose pull *": "ask",
                    "docker compose build *": "ask",
                    "docker compose down *": "ask",
                    "docker compose restart *": "ask",
                    "git commit --amend *": "ask",
                    "git commit --amend": "ask",
                    "sed -i *": "allow",
                    "docker compose exec app php artisan migrate:fresh --seed --no-interaction": "allow"
                }
            }
        }
    },
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true
        },
        "filesystem": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "."
            ],
            "enabled": false
        },
        "laravel-boost": {
            "type": "local",
            "command": [
                "docker",
                "compose",
                "exec",
                "-T",
                "app",
                "php",
                "artisan",
                "boost:mcp"
            ],
            "enabled": true,
            "timeout": 30000
        }
    }
}